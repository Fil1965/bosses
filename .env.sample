# plantilla de variables de entorno — copiar a .env y rellenar
# (el .env lo carga node --env-file=.env: npm run editor / start / blizztest / blizzard-nombres)

# ----------------------------- Blizzard Game Data API -----------------------
# https://develop.battle.net/ (API client: OAuth client-credentials).
# Requeridas por scripts/_blizzard-api.mjs (blizzard-nombres, test-blizz y
# los retratos del editor web).
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --------------------------------------------------------- editor web -------
# Puerto del editor (por defecto 3088 si se deja vacío).
EDITOR_PORT=3088

# ----------------------------- NVIDIA NIM (traducción IA del editor) --------
# La usa web-editor/_ia.mjs (botón "traer y traducir con IA" del panel
# FUENTE). Si falta, el servidor usa la clave del programa de ejemplo del
# propietario (Mis Fuentes/node.js/nim/index.mjs) como fallback.
NVIDIA_API_KEY=
# Endpoint y modelo (por omisión integrate.api.nvidia.com/v1 y
# nvidia/nemotron-3-super-120b-a12b, como el programa de ejemplo).
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ----------------------------- traducción IA: proveedor -----------------------
# IA_PROVIDER elegible: "nvidia" (NIM de NVIDIA, por omisión) u "ollama"
# (servidor Ollama local). Los endpoints/modelos de cada uno están en su
# sección; el resto de la casa no cambia.
# IA_PROVIDER=ollama

# ----------------------------- Ollama local -----------------------------------
# La usa web-editor/_ia.mjs cuando IA_PROVIDER=ollama (API OpenAI-compatible
# /v1; Ollama ignora las claves). Si falta OLLAMA_MODEL, el servidor descubre
# los modelos instalados con GET /api/tags y usa el primero; mejor fijarlo
# con "ollama list" (y "ollama pull <modelo>" si falta). Los modelos de
# razonamiento (qwen3, deepseek-r1...) el editor los llama con
# reasoning_effort "none" para que respondan directo.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3.5:4b
OLLAMA_MODEL=translategemma:latest