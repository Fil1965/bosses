		"sections": [
			{
				"id": 8171,
				"title": "Machaque de magma",
				"body_text": "Inflige 0 p. de daño de Fuego que se divide a partes iguales entre los jugadores en un radio de 20 m del objetivo."
			},
			{
				"id": 8172,
				"title": "Alma ardiente",
				"body_text": "Inflige 0 p. de daño de Fuego cada 1 s durante 10 s. Al expirar, el jugador explota e inflige 3669 p. de daño de Fuego a los jugadores en un radio de 8 m y los lanza por los aires."
			},
			{
				"id": 8173,
				"title": "Charco de fuego",
				"body_text": "Crea un charco de fuego que inflige 931 p. de daño de Fuego cada 1 s."
			},
			{
				"id": 8174,
				"title": "Llama ancestral",
				"body_text": "Invoca un orbe que inflige 0 p. de daño de Fuego al jugador más cercano cada 2 s y aumenta el daño de Fuego recibido un 5% durante 10 s."
			},
			{
				"id": 8175,
				"title": "Agonía eterna",
				"body_text": "Después de 5 min, Ordos canaliza todo su poder hacia una gigantesca bola de magma, lo que inflige 0 p. de daño de Fuego a todos los jugadores cada 1 s."
			}
		],
