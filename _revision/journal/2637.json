		"sections": [
			{
				"id": 30005,
				"title": "Overview",
				"body_text": "Kordac defends Azeroth, targeting players with [Overcharged Lasers] which leave [Overcharged Earth] and [Empowering Coalescence] in their wake. Upon reaching 100 Energy, he rains down [Arcane Bombardment].",
				"sections": [
					{
						"id": 30006,
						"title": "Tanks",
						"body_text": "$bullet; Kordac's [Titanic Impact] inflicts high damage and launches players into the air.\r\n$bullet;[Supression Burst] pacifies and silences nearby players on detonation."
					},
					{
						"id": 30007,
						"title": "Healers",
						"body_text": "$bullet; [Overcharged Lasers] will pursue players and leave behind [Overcharged Earth].\r\n$bullet;[Supression Burst] pacifies and silences any players near its target when it detonates."
					},
					{
						"id": 30008,
						"title": "Damage Dealers",
						"body_text": "$bullet; [Empowering Coalescence] can be collected for a brief damage increase.\r\n$bullet; [Overcharged Lasers] will pursue players and leave behind [Overcharged Earth]."
					}
				]
			},
