		"sections": [
			{
				"id": 34055,
				"title": "Overview",
				"body_text": "Thorm'belan unleashes the power of the Light to assault the players. Periodically lobbing [Scintillating Shards] while also pulling players in towards itself with [Shredding Tendrils].",
				"sections": [
					{
						"id": 34056,
						"title": "Tanks",
						"body_text": "$bullet; [Scintillating Shard] causes all players to become stunned if it is not intercepted.\r\n$bullet; [Shredding Tendrils] pulls players towards Thorm'belan and inflicts damage until players move far enough away from Thorm'belan.\r\n$bullet; [Radiant Mote] damages and disorients nearby players when it expires."
					},
					{
						"id": 34057,
						"title": "Healers",
						"body_text": "$bullet; [Scintillating Shard] causes all players to become stunned if it is not intercepted.\r\n$bullet; [Shredding Tendrils] pulls players towards Thorm'belan and inflicts damage until players move far enough away from Thorm'belan.\r\n$bullet; [Radiant Mote] damages and disorients nearby players when it expires."
					},
					{
						"id": 34058,
						"title": "Damage Dealers",
						"body_text": "$bullet; [Scintillating Shard] causes all players to become stunned if it is not intercepted.\r\n$bullet; [Shredding Tendrils] pulls players towards Thorm'belan and inflicts damage until players move far enough away from Thorm'belan.\r\n$bullet; [Radiant Mote] damages and disorients nearby players when it expires."
					}
				]
