		"sections": [
			{
				"id": 5635,
				"title": "Commandant Durand",
				"body_text": "Le nouveau commandant de la Croisade écarlate attaque les personnages-joueurs avec une série de frappes fulgurantes.",
				"sections": [
					{
						"id": 5636,
						"title": "L’éclat de l’acier",
						"body_text": "Le commandant Durand parcourt rapidement le champ de bataille, attaquant des personnages-joueurs au hasard et infligeant 0 points de dégâts physiques à chaque coup."
					},
					{
						"id": 5637,
						"title": "Frappe audacieuse",
						"body_text": "Le commandant Durand traverse rapidement les rangs ennemis, infligeant 839 points de dégâts physiques à chaque ennemi sur son chemin."
					}
				]
			},
			{
				"id": 5638,
				"title": "Grande inquisitrice Blanchetête",
				"body_text": "La grande inquisitrice de la Croisade écarlate aide le commandant Durand quand il tombe et le ranime pour l’aider au combat.",
				"sections": [
					{
						"id": 5639,
						"title": "Mot de pouvoir : Bouclier",
						"body_text": "La grande inquisitrice Blanchetête enveloppe un allié dans un bouclier magique qui absorbe 0 points de dégâts."
					},
					{
						"id": 5640,
						"title": "Châtiment sacré",
						"body_text": "La grande inquisitrice Blanchetête châtie sa cible actuelle, infligeant 384 points de dégâts du Sacré."
					},
					{
						"id": 5641,
						"title": "Résurrection de masse",
						"body_text": "La grande inquisitrice Blanchetête ranime tous les Judicateurs écarlates tombés au combat dans un rayon de 100 mètres pour qu’ils viennent l’aider."
					}
				]
			}
		],
