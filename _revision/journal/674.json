		"sections": [
			{
				"id": 5635,
				"title": "Comandante Durand",
				"body_text": "El nuevo comandante militar de la Cruzada Escarlata ataca a los jugadores con una serie de golpes rápidos como el rayo.",
				"sections": [
					{
						"id": 5636,
						"title": "Destello de acero",
						"body_text": "Mientras el comandante Durand se mueve rápidamente por el campo de batalla, ataca a jugadores aleatorios e inflige 0 p. de daño físico cada vez que golpea."
					},
					{
						"id": 5637,
						"title": "Golpe arrasador",
						"body_text": "El comandante Durand atraviesa rápidamente a sus enemigos hasta llegar a una ubicación e inflige 839 p. de daño físico a todos los enemigos que encuentra a su paso."
					}
				]
			},
			{
				"id": 5638,
				"title": "Alta inquisidora Melenablanca",
				"body_text": "La alta inquisidora de la Cruzada Escarlata viene en ayuda del comandante Durand cuando este cae y lo resucita para que luche a su lado.",
				"sections": [
					{
						"id": 5639,
						"title": "Palabra de poder: escudo",
						"body_text": "La alta inquisidora Melenablanca rodea a un aliado con un escudo mágico que absorbe 0 p. de daño."
					},
					{
						"id": 5640,
						"title": "Punición Sagrada",
						"body_text": "La alta inquisidora Melenablanca pune a su objetivo actual, lo que inflige 360 p. de daño Sagrado."
					},
					{
						"id": 5641,
						"title": "Resurrección en masa",
						"body_text": "La alta inquisidora Melenablanca resucita a todos los enjuiciadores Escarlata caídos en un radio de 100 m para que acudan en su ayuda."
					}
				]
			}
		],
