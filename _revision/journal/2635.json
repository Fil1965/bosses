		"sections": [
			{
				"id": 29927,
				"title": "Overview",
				"body_text": "The Aggregation of Horrors expels shards of rock during [Crystalline Barrage]. These shards arise Fractured Skardyn during[Dark Awakening].",
				"sections": [
					{
						"id": 29928,
						"title": "Tanks",
						"body_text": "$bullet;[Crystal Strike] inflicts heavy Shadow damage on impact and over time.\r\n$bullet;[Voidquake] inflicts Shadow damage to players caught within 150 yards."
					},
					{
						"id": 29929,
						"title": "Healer",
						"body_text": "$bullet;[Voidquake] inflicts Shadow damage to players caught within 150 yards.\r\n$bullet;[Crystalline Barrage] inflicts a large amount of damage to players hit by shards."
					},
					{
						"id": 29930,
						"title": "Damage Dealers",
						"body_text": "$bullet;[Voidquake] inflicts Shadow damage to players caught within 150 yards.\r\n$bullet;The Aggregation of Horrors cast [Annihilation Barrage] when no players are in melee combat.\r\n$bullet;[Dark Awakening] creates Fractured Skardyn that attack nearby players."
					}
				]
			},
			{
				"id": 29932,
				"title": "Crystalline Barrage",
				"spell": {
					"key": {
						"href": "https://eu.api.blizzard.com/data/wow/spell/452210?namespace=static-12.1.0_68914-eu"
					},
