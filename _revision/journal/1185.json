		"sections": [
			{
				"id": 9823,
				"title": "Resumen",
				"body_text": "El Vigilante graba patrones de luz abrasadora en el suelo y arroja sus enormes armas-escudo para atacar a sus enemigos.",
				"sections": [
					{
						"id": 10717,
						"title": "DPS",
						"body_text": "$bullet;Refúgiate detrás del [Escudo sagrado] lanzado por Kaathar para protegerte de su [Luz consagrada]."
					},
					{
						"id": 10716,
						"title": "Sanadores",
						"body_text": "$bullet;Refúgiate detrás del [Escudo sagrado] lanzado por Kaathar para protegerte de su [Luz consagrada]."
					},
					{
						"id": 10718,
						"title": "Tanques",
						"body_text": "$bullet;Refúgiate detrás del [Escudo sagrado] lanzado por Kaathar para protegerte de su [Luz consagrada].\r\n$bullet;Procura no colocar a Kaathar demasiado cerca de su [Escudo sagrado] para asegurarte de que haya un sitio seguro en el que esconderse de la [Luz consagrada]."
					}
				]
