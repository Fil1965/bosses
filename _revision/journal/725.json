		"sections": [
			{
				"id": 6141,
				"title": "Disparo de Fuego",
				"body_text": "Los hostigadores saurok sobre el lomo de Galeón disparan virotes flamígeros a los jugadores de manera aleatoria, lo que inflige 0 p. de daño de Fuego."
			},
			{
				"id": 6199,
				"title": "Pisotón",
				"body_text": "Galeón da un pisotón en el suelo, lo que inflige 0 p. de daño físico a los jugadores que estén en un radio de 100 m y los repele durante 3 s."
			},
			{
				"id": 6142,
				"title": "Tromba de cañón",
				"body_text": "El Jefe Salyis ordena a sus esbirros que disparen 8 poderosos cañonazos. Cada impacto inflige 0 p. de daño de Fuego a los jugadores en un radio de 10 m y los derriba."
			},
			{
				"id": 6200,
				"title": "Belicista Salyin",
				"body_text": "Los belicistas del Jefe Salyis saltan periódicamente desde el lomo de Galeón para enfrentarse a los jugadores.",
				"sections": [
					{
						"id": 6201,
						"title": "Atracción empaladora",
						"body_text": "Los belicistas utilizan una atracción empaladora para atraer a un objetivo distante hacia ellos y así infligir 0 p. de daño físico."
					}
				],
