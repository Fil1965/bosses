		"sections": [
			{
				"id": 6141,
				"title": "Flèche de feu",
				"body_text": "Les tirailleurs sauroks postés sur le dos de Galion tirent des carreaux d’arbalète enflammés en visant des personnages-joueurs au hasard, leur infligeant 0 points de dégâts de Feu."
			},
			{
				"id": 6199,
				"title": "Piétinement",
				"body_text": "Galion piétine le sol, infligeant 0 points de dégâts physiques à tous les personnages-joueurs se trouvant à moins de 100 mètres et les envoyant à terre pendant 3 s."
			},
			{
				"id": 6142,
				"title": "Barrage au canon",
				"body_text": "Le chef Salyis ordonne à ses serviteurs de tirer huit puissants coups de canon. Chacun inflige 0 points de dégâts de Feu aux personnages-joueurs situés à moins de 10 mètres et les fait tomber à la renverse."
			},
			{
				"id": 6200,
				"title": "Combattant salyin",
				"body_text": "Les combattants du chef Salyis sautent périodiquement du dos de Galion pour attaquer les personnages-joueurs.",
				"sections": [
					{
						"id": 6201,
						"title": "Empaler et tirer",
						"body_text": "Le combattant lance Empaler et tirer pour ramener à lui une cible distante et lui inflige 0 points de dégâts physiques."
					}
				],
