		"sections": [
			{
				"id": 32613,
				"title": "Overview",
				"body_text": "Cragpine calls upon the treants of Zul'Aman with [Rootquake] as he shakes the earth beneath his feet.\r\n\r\nThe forest itself answers his call as he awakens [Ancient Seeds] slumbering in the soil.",
				"sections": [
					{
						"id": 32614,
						"title": "Healers",
						"body_text": "$bullet;[Rootquake] inflicts heavy damage to all players.\r\n$bullet;Floating [Ancient Seeds] inflict damage to nearby players."
					},
					{
						"id": 32615,
						"title": "Tanks",
						"body_text": "$bullet;Cragpine inflicts heavy melee damage while wielding a [War Club].\r\n$bullet;Angry treants pursue players endlessly until destroyed."
					},
