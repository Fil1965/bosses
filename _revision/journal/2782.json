		"sections": [
			{
				"id": 32613,
				"title": "Vue d’ensemble",
				"body_text": "Grâce au [Séisme racinaire], Pincombe appelle les tréants de Zul’Aman en faisant trembler le sol sous ses pieds.\r\n\r\nLa forêt répond à son appel alors qu’il réveille les [Graines antiques] sommeillant sous terre.",
				"sections": [
					{
						"id": 32614,
						"title": "Soins",
						"body_text": "$bullet;[Séisme racinaire] inflige de lourds dégâts à tous les personnages-joueurs.\r\n$bullet;Des [Graines antiques] flottantes infligent des dégâts aux personnages-joueurs proches."
					},
					{
						"id": 32615,
						"title": "Tank",
						"body_text": "$bullet;Pincombe inflige de lourds dégâts de mêlée en agitant une [Massue de guerre].\r\n$bullet;Des tréants en colère poursuivent inlassablement les personnages-joueurs jusqu’à leur destruction."
					},
					{
						"id": 32616,
						"title": "DPS",
						"body_text": "$bullet;Des tréants en colère poursuivent inlassablement les personnages-joueurs jusqu’à leur destruction.\r\n$bullet;Des [Graines antiques] flottantes infligent des dégâts aux personnages-joueurs proches."
					}
				]
			},
