			{
				"id": 7146,
				"title": "Crush",
				"body_text": "Oondasta crushes his current target, inflicting 0 Physical damage and reducing armor by 25% for 1 min. This effect stacks."
			},
			{
				"id": 7723,
				"title": "Alpha Male",
				"body_text": "Oondasta seeks only the most hearty challengers, making him immune to taunts, but also increasing tank-specced players' threat against him by 100%."
			},
			{
				"id": 7147,
				"title": "Frill Blast",
				"body_text": "Oondasta's armor is more than just for decoration, and can charge up this powerful blast that inflicts 0 Fire damage to all players in a 60-yard hemisphere in front of Oondasta."
			},
			{
				"id": 7148,
				"title": "Growing Fury",
				"body_text": "Oondasta's rage grows as the fight progresses, increasing all damage by 10%. This effect stacks."
			},
			{
