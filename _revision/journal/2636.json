		"sections": [
			{
				"id": 29964,
				"title": "Resumen",
				"body_text": "Shurrai arroja [Vómito salobre] a los jugadores y después engulle a los jugadores y limpia el vómito con la [Marea oscura].\r\n\r\nAl llegar a 100 p. de energía, Shurrai lanza [Regurgitar almas] para invocar arathi ahogados y protegerse con el [Sudario del ahogado].",
				"sections": [
					{
						"id": 29965,
						"title": "Tanques",
						"body_text": "$bullet;[Golpe abisal] aplica una absorción de sanación equivalente a la cantidad de daño infligido.\r\n$bullet;[Marea oscura] elimina los charcos de [Vómito salobre].\r\n$bullet;Los arathi ahogados infligen una cantidad importante de daño a Shurrai cuando son destruidos."
					},
					{
						"id": 29966,
						"title": "Sanadores",
						"body_text": "$bullet;Los arathi ahogados infligen [Expiación del océano] al morir.\r\n$bullet;[Marea oscura] elimina los charcos de [Vómito salobre].\r\n$bullet;Los arathi ahogados infligen una cantidad importante de daño a Shurrai cuando son destruidos."
					},
					{
						"id": 29967,
						"title": "DPS",
						"body_text": "$bullet;[Marea oscura] elimina los charcos de [Vómito salobre].\r\n$bullet;Los arathi ahogados infligen una cantidad importante de daño a Shurrai cuando son destruidos."
					}
				]
			},
