		"sections": [
			{
				"id": 14791,
				"title": "Overview",
				"body_text": "Brutallus' [Meteor Slash] is devastating unless its damage is shared between many enemies.\r\n\r\nAvoid taking damage from [Crashing Embers], especially when affected by [Meteor Slash].",
				"sections": [
					{
						"id": 14794,
						"title": "Damage Dealers",
						"body_text": "$bullet;Stand near your allies when Brutallus casts [Meteor Slash].\r\n$bullet;Avoid taking damage from [Crashing Embers], especially when affected by [Meteor Slash]."
					},
					{
						"id": 14795,
						"title": "Tanks",
						"body_text": "$bullet;Face Brutallus toward a large group of allies when he casts [Meteor Slash]."
					},
					{
						"id": 14792,
						"title": "Healers",
						"body_text": "$bullet;Stand near your allies when Brutallus casts [Meteor Slash].\r\n$bullet;Prioritize allies affected by [Meteor Slash] for heavy healing if they are affected by [Crashing Embers]."
					}
				]
			},
