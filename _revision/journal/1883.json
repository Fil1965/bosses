		"sections": [
			{
				"id": 14791,
				"title": "Vue d’ensemble",
				"body_text": "L’[Attaque météorique] de Brutallus est dévastatrice à moins que ses dégâts soient répartis entre de nombreux ennemis.\r\n\r\nÉvitez les dégâts infligés par [Braises percutantes], en particulier lorsque vous subissez les effets d’[Attaque météorique].",
				"sections": [
					{
						"id": 14794,
						"title": "DPS",
						"body_text": "$bullet;Restez près de vos alliés lorsque Brutallus lance [Attaque météorique].\r\n$bullet;Évitez les dégâts infligés par [Braises percutantes], en particulier lorsque vous subissez les effets d’[Attaque météorique]."
					},
					{
						"id": 14795,
						"title": "Tanks",
						"body_text": "$bullet;Orientez Brutallus vers un grand groupe d’alliés lorsqu’il lance [Attaque météorique]."
					},
					{
						"id": 14792,
						"title": "Soigneurs",
						"body_text": "ullet; Restez près de vos alliés lorsque Brutallus lance [Attaque météorique].\r\n$bullet; Prodiguez des soins importants en priorité aux alliés touchés par [Attaque météorique] s’ils subissent les effets de [Braises percutantes]."
					}
				]
			},
