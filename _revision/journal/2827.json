		"sections": [
			{
				"id": 34883,
				"title": "Overview",
				"body_text": "Lu'ashal assails foes in a holy frenzy, raining energy from the skies with [Radiant Sunder]  to shatter the ground that leave [Blinding Fissures] behind. During [Radiant Flare], she unleashes waves of [Radiant Embers] that travel across the battlefield.",
				"sections": [
					{
						"id": 34884,
						"title": "Healers",
						"body_text": "$bullet; [Dawncrazed Halo] inflicts moderate damage in an area around afflicted players.\r\n$bullet; [Radiant Flare] inflicts substantial damage and casues [Radiant Embers] to erupt from [Blinding Fissures] ."
					},
					{
						"id": 34885,
						"title": "Tanks",
						"body_text": "$bullet; [Dawnfire Breath] inflicts heavy Radiant damage in a cone at the primary target.\r\n$bullet; [Radiant Flare] inflicts substantial damage and casues [Radiant Embers] to erupt from [Blinding Fissures] ."
					},
					{
						"id": 34886,
						"title": "Damage Dealers",
						"body_text": "$bullet; [Dawncrazed Halo] inflicts moderate damage in an area around afflicted players.\r\n$bullet; [Radiant Flare] inflicts substantial damage and casues [Radiant Embers] to erupt from [Blinding Fissures] ."
					}
				]
