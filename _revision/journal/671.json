		"sections": [
			{
				"id": 5601,
				"title": "Poings flamboyants",
				"body_text": "Frère Korloff commence à déchaîner un déluge de coups embrasés, infligeant 40% de ses dégâts de mêlée normaux sous forme de dégâts de Feu aux cibles devant lui toutes les 1 s pendant 6 s."
			},
			{
				"id": 5602,
				"title": "Coup de pied de la tempête de feu",
				"body_text": "Frère Korloff vole vers un personnage-joueur choisi au hasard et exécute un coup de pied de la tempête de feu, infligeant 0 points de dégâts de Feu à tous les personnages-joueurs à moins de 7 mètres."
			},
			{
				"id": 5603,
				"title": "Levée de flamme",
				"body_text": "Chaque fois que frère Korloff perd 10% de ses points de vie maximum, une levée de flammes brûle en lui. Il inflige alors 10% de dégâts de Feu supplémentaires. Cet effet se cumule."
			},
			{
				"id": 5604,
				"title": "Terre brûlée",
				"body_text": "A 50% de ses points de vie, frère Korloff brûle assez vivement pour laisser une traînée de feu derrière lui. Terre brûlée inflige 0 points de dégâts de Feu toutes les 1 s."
			}
		],
