		"sections": [
			{
				"id": 3008,
				"title": "Pip Quickwit",
				"body_text": "Pip Quickwit, gnome explorer extraordinare, has been captured by Nefarian and cannot be freed from his cage until Chimaeron is slain. A player can talk to Pip before the fight begins to convince him to activate his Bile-O-Tron, which helps keep the raid alive. Activating the Bile-O-Tron also wakes Chimaeron.",
				"sections": [
					{
						"id": 3009,
						"title": "Bile-O-Tron",
						"body_text": "When Pip activates the Bile-O-Tron, it moves about the room and sprays raid members with Pip's Mixture as long as it is active. Chimaeron periodically knocks the Bile-O-Tron offline.",
						"sections": [
							{
								"id": 3010,
								"title": "Pip's Mixture",
								"body_text": "The Bile-O-Tron sprays Pip's Mixture on the raid while online. Pip's Mixture prevents players whose health is above 10% from dropping below 1 health."
							}
						],
						"creature_display": {
							"key": {
								"href": "https://eu.api.blizzard.com/data/wow/media/creature-display/23361?namespace=static-12.1.0_68914-eu"
							},
							"id": 23361
						}
					}
				],
				"creature_display": {
					"key": {
						"href": "https://eu.api.blizzard.com/data/wow/media/creature-display/33716?namespace=static-12.1.0_68914-eu"
					},
					"id": 33716
				}
			},
			{
				"id": 3011,
				"title": "Stage One: Truly Something to Behold",
				"body_text": "Chimaeron attacks his current target with Break and Double Attack, while continually spraying Caustic Slime at the raid. He periodically casts Massacre on the raid, and his heads sometimes Feud following a Massacre.",
				"sections": [
					{
						"id": 3012,
						"title": "Caustic Slime",
						"body_text": "Chimaeron lobs Caustic Slime at two random players.  Each Caustic Slime inflicts 380 Nature damage, divided evenly among all players within 6 yards of the target. Caustic Slime also reduces chance to hit by 75% for 2.5 sec."
					},
					{
						"id": 3013,
						"title": "Massacre",
						"body_text": "Chimaeron hits all players for massive damage, probably killing anyone not under the effects of Pip's Mixture.\r\n\r\nMassacre sometimes knocks the Bile-O-Tron offline for a short period of time."
					},
					{
						"id": 3014,
						"title": "Feud",
						"body_text": "Whenever Chimaeron knocks the Bile-O-Tron offline, his two heads begin to argue with each other, preventing Chimaeron from perfoming melee attacks for 30 sec. "
					},
					{
						"id": 3015,
						"title": "Break",
						"body_text": "Chimaeron attacks viciously, breaking through his target's defenses and increasing their Physical damage taken by 25% and reducing healing done by 15% for 1 min. This effect stacks."
					},
					{
						"id": 3016,
						"title": "Double Attack",
						"body_text": "Chimaeron strikes twice with his next attack."
					}
				]
			},
			{
				"id": 3017,
				"title": "Stage Two: A Horrific Creation",
				"body_text": "At 20% health Chimaeron goes into a rage. This renders him immune to Taunt effects and greatly decreases healing done by players.",
				"sections": [
					{
						"id": 3018,
						"title": "Mortality",
						"body_text": "Chimaeron goes into a rage, rendering him immune to Taunt effects. In addition, he reduces healing effects done to players by 99%.\r\n\r\nIn 10 player raids Chimaeron takes 10% increased damage while Mortality is active."
					},
					{
						"id": 3019,
						"title": "Double Attack",
						"body_text": "Chimaeron strikes twice with his next attack."
					},
					{
						"id": 3020,
						"title": "Mocking Shadows",
						"body_text": "Lord Victor Nefarius inflicts 0 Shadow damage every second to all players."
					}
				]
			}
		],
