		"sections": [
			{
				"id": 34925,
				"title": "Overview",
				"body_text": "Predaxas thrashes about the Gorging Pit ejecting his late lunch at foes with [Regurgitation] and crushing vermin with [Seismic Slam].",
				"sections": [
					{
						"id": 34926,
						"title": "Tanks",
						"body_text": "$bullet;[Regurgitation] ejects Predaxas' previous meals which attack players.\r\n$bullet;[Seismic Slam] knocks back players and Predaxas' previous meals, causing additional effects."
					},
					{
						"id": 34927,
						"title": "Damage Dealers",
						"body_text": "$bullet;[Seismic Slam] knocks back players and Predaxas' previous meals, causing additional effects.\r\n$bullet;Voidticks react to [Seismic Slam] triggering [Voidscatter]."
					},
					{
						"id": 34928,
						"title": "Healers",
						"body_text": "$bullet;Reguritated Bloodclaws periodically gain [Bestial Rage] inflicting increased damage.\r\n$bullet;[Seismic Slam] knocks back players and Predaxas' previous meals, causing additional effects."
					}
				]
