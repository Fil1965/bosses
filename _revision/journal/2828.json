		"sections": [
			{
				"id": 34925,
				"title": "Resumen",
				"body_text": "Predaxas da vueltas por el Foso Engullidor y lanza lo que ha comido contra sus enemigos valiéndose de [Regurgitación]. También aplasta a las alimañas con [Embate sísmico].",
				"sections": [
					{
						"id": 34926,
						"title": "Tanques",
						"body_text": "$bullet;[Regurgitación] expulsa las comidas anteriores de Predaxas, que atacan a los jugadores.\r\n$bullet;[Embate sísmico] repele a los jugadores y a las comidas anteriores de Predaxas, lo que provoca efectos adicionales."
					},
					{
						"id": 34927,
						"title": "DPS",
						"body_text": "$bullet;[Embate sísmico] repele a los jugadores y a las comidas anteriores de Predaxas, lo que provoca efectos adicionales.\r\n$bullet;Las garrapatas del Vacío reaccionan a [Embate sísmico] y activan [Dispersión del Vacío]."
					},
					{
						"id": 34928,
						"title": "Sanadores",
						"body_text": "$bullet;Los Garrasangre obtienen periódicamente [Cólera bestial] e infligen más daño.\r\n$bullet;[Embate sísmico] repele a los jugadores y a las comidas anteriores de Predaxas, lo que provoca efectos adicionales."
					}
				]
			},
